{
  "manifest_version": 3,
  "name": "Design Inspector",
  "version": "0.1.0",
  "description": "Inspect colors and typography on web pages.",
  "action": {
    "default_title": "Design Inspector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ]
}
